# ==============================================================================
# LAND PARCEL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# IMPORTANT: .env.local is ignored by .gitignore and should NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL Database & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SECRET SERVICE ROLE KEY — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. SUPER ADMIN CONFIGURATION — ADITYA RAJ (SERVER-ONLY)
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME="Aditya Raj"
SUPER_ADMIN_MOBILE=8377056503
SUPER_ADMIN_EMAIL=acreindiaclub@gmail.com
SUPER_ADMIN_PASSWORD=set-a-strong-unique-password-here
ADMIN_SESSION_SECRET=set-a-random-64-char-secret-for-admin-hmac-signing
CUSTOMER_SESSION_SECRET=set-a-random-64-char-secret-for-customer-hmac-signing

# ------------------------------------------------------------------------------
# 3. MOBILE OTP & WHATSAPP INTEGRATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=918750442235
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional SMS OTP Provider (e.g., MSG91 or Twilio) for live OTP delivery
SMS_OTP_PROVIDER=
SMS_OTP_API_KEY=

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY & OFFICIAL RECEIVING ACCOUNT (CONFIGURE YOUR REAL DETAILS)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Leave blank until you enter your own official verified payment details
NEXT_PUBLIC_OFFICIAL_UPI_ID=
NEXT_PUBLIC_OFFICIAL_BANK_NAME=
NEXT_PUBLIC_OFFICIAL_BANK_ACCOUNT=
NEXT_PUBLIC_OFFICIAL_BANK_IFSC=
NEXT_PUBLIC_OFFICIAL_BENEFICIARY_NAME="Land Parcel"

# ------------------------------------------------------------------------------
# 5. AUTOMATION & MAPS (OPTIONAL)
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 6. SITE METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Land Parcel"
