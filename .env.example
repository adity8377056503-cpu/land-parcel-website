# ==============================================================================
# LAND PARCEL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# IMPORTANT: .env.local is ignored by .gitignore and should NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL Database & Storage)
# The website runs locally with an in-memory/localStorage fallback if left blank.
# ------------------------------------------------------------------------------
# Public Anon Key (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SECRET SERVICE ROLE KEY:
# SECURITY WARNING: NEVER add NEXT_PUBLIC_ prefix to this variable.
# This key has full administrative bypass of Row Level Security (RLS)
# and is ONLY accessed by server-side APIs (src/lib/supabase/server.ts).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. WHATSAPP INTEGRATION (Dual Mode: Click-to-Chat & Cloud API)
# ------------------------------------------------------------------------------
# Official Land Parcel WhatsApp Number: 8750442235
# Include country code without '+' or spaces (e.g., 91 for India).
NEXT_PUBLIC_WHATSAPP_NUMBER=918750442235

# Meta WhatsApp Cloud API credentials (Optional - for future automated dispatch)
# If left blank, the website automatically uses the instant click-to-chat fallback.
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------------------------
# 3. n8n AUTOMATION WEBHOOK (Lead Ingestion & WhatsApp Follow-up)
# ------------------------------------------------------------------------------
# Configurable webhook endpoint for asynchronous CRM and notification routing.
# Leave blank to keep inactive until production activation.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. GOOGLE MAPS PLATFORM
# ------------------------------------------------------------------------------
# API Key for Google Maps property markers and autocomplete.
# Leave blank to use coordinates and fallback map display.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY & MONETIZATION (Subscriptions & Listings)
# ------------------------------------------------------------------------------
# Razorpay / Payment Gateway credentials for future automated checkout.
# If left blank, the website uses offline UPI / NEFT with manual admin verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Land Parcel Official Bank & UPI Details (Suraj Prakash)
UPI_ID=8750442235@paytm
BANK_NAME=HDFC Bank Ltd.
BANK_ACCOUNT_NO=50200088991122
BANK_IFSC=HDFC0000123
BANK_ACCOUNT_NAME="SURAJ PRAKASH (LAND PARCEL)"

# ------------------------------------------------------------------------------
# 6. SITE METADATA & ADMIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Land Parcel"
ADMIN_EMAIL=acreindiaclub@gmail.com
ADMIN_PASSWORD=Admin@LandParcel2026
ADMIN_SESSION_SECRET=your-random-32-character-secret-key-for-admin-session-signing
BUSINESS_OWNER="Suraj Prakash"
OFFICIAL_WHATSAPP=8750442235
